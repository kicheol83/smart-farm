{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/smart-farm/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/smart-farm/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/smart-farm",
  "projects": {
    "smart-farm.batch": {
      "type": "application",
      "root": "apps/smart-farm.batch",
      "entryFile": "main",
      "sourceRoot": "apps/smart-farm.batch/src",
      "compilerOptions": {
        "tsConfigPath": "apps/smart-farm.batch/tsconfig.app.json"
      }
    },
    "smart-farm": {
      "type": "application",
      "root": "apps/smart-farm",
      "entryFile": "main",
      "sourceRoot": "apps/smart-farm/src",
      "compilerOptions": {
        "tsConfigPath": "apps/smart-farm/tsconfig.app.json"
      }
    }
  }
}